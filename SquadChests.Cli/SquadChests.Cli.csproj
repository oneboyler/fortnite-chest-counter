<Project Sdk="Microsoft.NET.Sdk">

  <!-- ChestStats.exe: text report and research commands (stats, watch, games, dump, items, search, discover). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChestStats</AssemblyName>
    <RootNamespace>SquadChests.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SquadChests\SquadChests.csproj" />
  </ItemGroup>

</Project>
